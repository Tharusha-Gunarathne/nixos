# ══════════════════════════════════════════════════════════════════════════════
#  .env.local.example — Template for machine-specific & sensitive configuration
# ══════════════════════════════════════════════════════════════════════════════
#
#  HOW TO USE:
#  1. cp .env.local.example .env.local
#  2. Fill in your real values in .env.local (it is gitignored).
#  3. The flake reads it automatically — no other steps needed.
#
#  FORMAT: TOML — parsed natively by Nix via builtins.fromTOML.
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# [user] — Primary user identity
# ─────────────────────────────────────────────────────────────────────────────
[user]
username  = ""   # your NixOS login name, e.g. "alice"
repo_dir  = "nixos"
uid       = 1000 # your UID (run: id -u)
display_name = "" # e.g. "Alice Smith" — used to scrub your name from synced
                   # Noctalia widget settings before they're committed.
                   # Leave empty to auto-derive from username (hyphen-
                   # separated segments, title-cased).
# GitHub credentials
git_name  = ""   # e.g. "Alice Smith"
git_email = ""   # e.g. "alice@example.com"

[github]
access_token = "" # e.g. "ghp_..."

# ─────────────────────────────────────────────────────────────────────────────
# [storage] — Filesystem UUIDs
# Find UUIDs:  lsblk -f   or   ls -la /dev/disk/by-uuid/
# ─────────────────────────────────────────────────────────────────────────────
[storage]
root_uuid = ""   # ext4 root partition UUID
boot_uuid = ""   # FAT32 EFI/boot partition UUID

[[storage.data_drives]]
name = "D_Drive"
uuid = ""   # NTFS partition UUID (lsblk -f | grep ntfs)

[[storage.data_drives]]
name = "E_Drive"
uuid = ""


# ─────────────────────────────────────────────────────────────────────────────
# [hardware] — GPU PCI bus IDs & display resolution
# Find PCI IDs:  nix-shell -p pciutils --run "lspci | grep -E 'VGA|3D'"
# Convert "00:02.0" → "PCI:0:2:0"
# ─────────────────────────────────────────────────────────────────────────────
[hardware]
intel_bus_id   = ""    # e.g. "PCI:0:2:0"
nvidia_bus_id  = ""    # e.g. "PCI:1:0:0"

display_width  = 2560
display_height = 1600


# ─────────────────────────────────────────────────────────────────────────────
# [network]
# Set static_ip = "" to skip static assignment (use DHCP)
# ─────────────────────────────────────────────────────────────────────────────
[network]
static_ip     = ""    # e.g. "192.168.1.100"  — leave empty for DHCP
prefix_length = 24
extra_tcp_ports = [] # Optional private service/development ports

# ─────────────────────────────────────────────────────────────────────────────
# [hotspot] — WiFi hotspot configuration (created via NetworkManager)
# interface: run `nmcli device` to find your WiFi interface name (e.g. wlan0)
# band: "bg" = 2.4 GHz (wider compat), "a" = 5 GHz (faster, shorter range)
# ─────────────────────────────────────────────────────────────────────────────
[hotspot]
ssid      = "MyHotspot"    # broadcast name
password  = ""             # min 8 chars; leave empty to disable starting until supplied
interface = "wlan0"        # your WiFi interface
band      = "bg"           # "bg" for 2.4 GHz, "a" for 5 GHz


# ─────────────────────────────────────────────────────────────────────────────
# [nvidia_nim] — NVIDIA NIM API credentials
# Get key: https://build.nvidia.com/settings/api-keys
# ─────────────────────────────────────────────────────────────────────────────
[nvidia_nim]
api_key                 = ""
openwebui_default_model = "stepfun-ai/step-3.5-flash"
fcc_model_default       = "nvidia_nim/deepseek-ai/deepseek-v4-pro"
fcc_model_opus          = "nvidia_nim/z-ai/glm-5.1"
fcc_model_sonnet        = "nvidia_nim/deepseek-ai/deepseek-v4-pro"
fcc_model_haiku         = "nvidia_nim/deepseek-ai/deepseek-v4-flash"
fcc_auth_token          = "freecc"
fcc_proxy_port          = 8082

# ─────────────────────────────────────────────────────────────────────────────
# [tailscale] — Tailscale VPN
# Get a reusable auth key: https://login.tailscale.com/admin/settings/keys
# Leave auth_key empty to skip automatic authentication (run ts-up manually).
# ─────────────────────────────────────────────────────────────────────────────
[tailscale]
auth_key = ""   # e.g. "tskey-auth-..."

# ─────────────────────────────────────────────────────────────────────────────
# [paths] — Absolute paths that vary per machine
# ─────────────────────────────────────────────────────────────────────────────
[paths]
wallpaper_dir    = ""   # e.g. "/home/alice/Pictures/Wallpapers"
avatar_image     = ""   # e.g. "/home/alice/.face"


# ─────────────────────────────────────────────────────────────────────────────
# [noctalia]
# bar_monitor / dock_monitor: run `niri msg outputs` to find your output name
# ─────────────────────────────────────────────────────────────────────────────
[noctalia]
bar_monitor   = "eDP-1"
dock_monitor  = "eDP-1"
location_name = ""   # Optional location label


# Optional local launchers. Keep application names and paths out of Git.
# [desktop_entries.my-tool]
# name = "My tool"
# command = "exec my-tool"
# icon = "application-x-executable"
# categories = ["Utility"]
# terminal = false

[claude_sync]
shared_dir = "/mnt/shared/.claude-shared" # Set to your shared drive
manifest_overrides_json = "{}" # Optional per-machine JSON manifest overrides

[locale]
time_zone = "UTC"
