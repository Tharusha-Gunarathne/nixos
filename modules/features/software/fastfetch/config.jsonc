{
  "": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/images/head.png",
    "width": 20,
    "height": 13,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    { "type": "custom",       "key": "╭───────────╮" },
    { "type": "title",        "key": "│ {#31} user    {#keys}│", "format": "{user-name}" },
    { "type": "uptime",       "key": "│ {#33} uptime  {#keys}│" },
    { "type": "display",      "key": "│ {#32} display {#keys}│", "compactType": "original-with-refresh-rate" },
    { "type": "os",           "key": "│ {#34} distro  {#keys}│" },
    { "type": "kernel",       "key": "│ {#35} kernel  {#keys}│" },
    { "type": "wm",           "key": "│ {#36} wm      {#keys}│" },
    { "type": "terminal",     "key": "│ {#31} term    {#keys}│" },
    { "type": "shell",        "key": "│ {#32} shell   {#keys}│" },
    { "type": "packages",     "key": "│ {#33} apps    {#keys}│" },
    { "type": "disk",         "key": "│ {#34} disk    {#keys}│", "folders": "/" },
    { "type": "memory",       "key": "│ {#36} memory  {#keys}│" },
    { "type": "terminalfont", "key": "│ {#35} font    {#keys}│" },
    { "type": "command",      "key": "│ {#33} OS Age  {#keys}│",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" },
    { "type": "custom",       "key": "├───────────┤" },
    { "type": "colors",       "key": "│ {#39} colors  {#keys}│", "symbol": "circle" },
    { "type": "custom",       "key": "╰───────────╯" }
  ]
}