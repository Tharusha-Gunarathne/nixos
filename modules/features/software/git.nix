{localConfig, ...}: {
  flake.nixosModules.git = {
    config,
    pkgs,
    lib,
    ...
  }: let
    username = config.myConfig.primaryUser;
    homeDir = "/home/${username}";

    # Must match the displayName derivation in noctalia.nix exactly — that's
    # the value actually written into settings.toml.
    capitalize = s:
      if s == ""
      then s
      else lib.toUpper (builtins.substring 0 1 s) + builtins.substring 1 (builtins.stringLength s - 1) s;

    configuredDisplayName = localConfig.user.display_name or "";
    displayName =
      if configuredDisplayName != ""
      then configuredDisplayName
      else lib.concatStringsSep "-" (map capitalize (lib.splitString "-" username));

    # Literal strings replaced anywhere in the file. Base 3 are restored on
    # checkout by expandPlaceholdersScript in noctalia.nix (tokens must
    # match). Anything added via localConfig.git.redacted_values is one-way
    # (not restored) unless you also add a restore rule — fine for values
    # that don't need round-tripping.
    baseRedactedValues = {
      "${homeDir}" = "REDACTED-HOME";
      "${username}" = "REDACTED-USERNAME";
      "${displayName}" = "REDACTED-DISPLAY-NAME";
    };
    extraRedactedValues = localConfig.git.redacted_values or {};
    redactedValues = baseRedactedValues // extraRedactedValues;

    # Dotted TOML paths whose value gets fully blanked, "*" = wildcard key.
    # One-way redaction (no restore) — fine for file paths and account
    # labels that get regenerated by the app anyway.
    baseRedactedPaths = [
      "wallpaper.default.path"
      "wallpaper.last.path"
      "wallpaper.monitors.*.path"
      "calendar.account.*.name"
    ];
    extraRedactedPaths = localConfig.git.redacted_paths or [];
    redactedPaths = baseRedactedPaths ++ extraRedactedPaths;

    noctaliaSettingsCleanFilter = pkgs.writers.writePython3 "noctalia-settings-clean-filter" {
      libraries = [pkgs.python3Packages.tomlkit];
      flakeIgnore = ["E231" "E501" "E302" "E305"];
    } ''
      import sys
      import tomlkit

      REDACTED_VALUES = ${builtins.toJSON redactedValues}
      REDACTED_PATHS = ${builtins.toJSON redactedPaths}
      PLACEHOLDER = "REDACTED-BY-GIT-FILTER"

      text = sys.stdin.read()
      for real, placeholder in REDACTED_VALUES.items():
          if real:
              text = text.replace(real, placeholder)

      doc = tomlkit.parse(text)

      def redact_path(node, parts):
          if node is None or not hasattr(node, "get"):
              return
          key, rest = parts[0], parts[1:]
          if key == "*":
              for k in list(node.keys()):
                  if rest:
                      redact_path(node.get(k), rest)
                  else:
                      node[k] = PLACEHOLDER
              return
          if key not in node:
              return
          if rest:
              redact_path(node.get(key), rest)
          else:
              node[key] = PLACEHOLDER

      for path in REDACTED_PATHS:
          redact_path(doc, path.split("."))

      sys.stdout.write(tomlkit.dumps(doc))
    '';
  in {
    home-manager.users.${username} = {...}: {
      # gh can't write the credential helper itself: ~/.config/git/config
      # is a read-only nix store link, so declare it here.
      programs.gh = {
        enable = true;
        gitCredentialHelper.enable = true;
      };
      programs.git = {
        enable = true;
        settings = {
          user = {
            name = localConfig.user.git_name;
            email = localConfig.user.git_email;
          };
          filter.noctalia-settings = {
            clean = "${noctaliaSettingsCleanFilter}";
            smudge = "cat";
            required = false;
          };
        };
      };
    };
  };
}